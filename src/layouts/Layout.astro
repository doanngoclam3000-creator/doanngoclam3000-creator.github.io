---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CAUHINH } from '../config';

interface Props { tieuDe?: string; moTa?: string; anh?: string; loai?: string; }
const { tieuDe, moTa = CAUHINH.moTa, anh, loai = 'website' } = Astro.props;
const tieuDeDayDu = tieuDe ? `${tieuDe} — ${CAUHINH.tenSite}` : `${CAUHINH.tenSite} — ${CAUHINH.khauHieu}`;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tieuDeDayDu}</title>
  <meta name="description" content={moTa} />
  <link rel="canonical" href={url} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={CAUHINH.tenSite} href="/rss.xml" />
  <meta property="og:type" content={loai} />
  <meta property="og:title" content={tieuDeDayDu} />
  <meta property="og:description" content={moTa} />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content={CAUHINH.tenSite} />
  <meta property="og:locale" content="vi_VN" />
  {anh && <meta property="og:image" content={new URL(anh, Astro.site)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var t = localStorage.getItem('giao-dien');
      if (!t) t = 'dark';
      document.documentElement.dataset.theme = t;
    })();
  </script>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>
