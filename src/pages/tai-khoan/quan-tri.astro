---
import Layout from '../../layouts/Layout.astro';
import '../../styles/tai-khoan.css';
---

<Layout tieuDe="Quản trị ví" moTa="Trang quản trị ví tiền — chỉ chủ shop dùng." anGoogle={true}>
  <div class="tk-trang">
    <div class="khung-rong">

      <div class="tk-dau"><h1>Quản trị ví</h1></div>

      <div class="hop" id="o-khoa">
        <h2>Nhập mã quản trị</h2>
        <div class="loi" id="qt-loi" hidden></div>
        <label class="o o-vua">
          <span>Mã quản trị của máy chủ ví</span>
          <input type="password" id="qt-ma" autocomplete="off" />
        </label>
        <button class="nut nut-chinh" id="qt-vao" type="button">Vào</button>
      </div>

      <div id="o-chinh" hidden>
        <div class="loi" id="qt-bao" hidden></div>

        <div class="hop">
          <h2>Tổng quan</h2>
          <div class="luoi-so" id="tong-quan"></div>
        </div>

        <div class="hop">
          <h2>Yêu cầu rút tiền đang chờ</h2>
          <p class="loi-mo">
            Chuyển khoản tay cho khách trước, chuyển xong mới bấm <b>Đã trả</b>.
            Tiền đã bị giữ khỏi ví khách lúc họ gửi yêu cầu, từ chối là hoàn lại ngay.
          </p>
          <div class="cuon"><table class="bang">
            <thead><tr><th>Ngày</th><th>Khách</th><th class="phai">Thực trả</th><th>Ngân hàng</th><th></th></tr></thead>
            <tbody id="rut-than"></tbody>
          </table></div>
          <div class="trong" id="rut-trong" hidden>Không có yêu cầu nào đang chờ.</div>
        </div>

        <div class="hop">
          <h2>Đơn chờ cấp key tay</h2>
          <div class="cuon"><table class="bang">
            <thead><tr><th>Ngày</th><th>Khách</th><th>Phần mềm</th><th>Gói</th><th>Mã máy</th><th class="phai">Giá</th><th>Key</th></tr></thead>
            <tbody id="don-than"></tbody>
          </table></div>
          <div class="trong" id="don-trong" hidden>Không có đơn nào đang chờ.</div>
        </div>

        <div class="hop">
          <h2>Khách hàng</h2>
          <label class="o o-vua">
            <span>Tìm theo email, tên hoặc mã nạp</span>
            <input type="search" id="kh-tim" placeholder="Bỏ trống để xem 100 người mới nhất" />
          </label>
          <button class="nut nut-vien" id="kh-nut" type="button">Tìm</button>
          <div class="cuon dat-tren"><table class="bang">
            <thead><tr><th>Email</th><th>Tên</th><th>Mã nạp</th><th class="phai">Số dư</th><th class="phai">Đã nạp</th><th></th></tr></thead>
            <tbody id="kh-than"></tbody>
          </table></div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    (function () {
      var V = window.VI;
      var $ = function (id) { return document.getElementById(id); };
      var ma = '';

      async function qt(duong, than) {
        var r = await fetch(V.goc + duong, {
          method: than ? 'POST' : 'GET',
          headers: { 'content-type': 'application/json', authorization: 'Apikey ' + ma },
          body: than ? JSON.stringify(than) : undefined,
        });
        var o = await r.json().catch(function () { return {}; });
        if (!r.ok) throw new Error(o.loi || ('Máy chủ trả mã ' + r.status));
        return o;
      }

      // Bao loi ngay tren trang, khong dung alert/confirm/prompt cua trinh duyet:
      // hop thoai cua trinh duyet chan het thao tac khac cho toi khi bam OK.
      function bao(e) { V.baoLoi('qt-bao', e); if (e) window.scrollTo({ top: 0, behavior: 'smooth' }); }

      $('qt-vao').addEventListener('click', vao);
      $('qt-ma').addEventListener('keydown', function (e) { if (e.key === 'Enter') vao(); });

      async function vao() {
        ma = $('qt-ma').value.trim();
        V.baoLoi('qt-loi', '');
        try {
          await qt('/admin/tong-quan');
          localStorage.setItem('vi-qt', ma);
          $('o-khoa').hidden = true;
          $('o-chinh').hidden = false;
          taiHet();
        } catch (err) { V.baoLoi('qt-loi', err); }
      }

      function taiHet() {
        taiTongQuan().catch(bao); taiRut().catch(bao);
        taiDon().catch(bao); taiKhach().catch(bao);
      }

      async function taiTongQuan() {
        var k = await qt('/admin/tong-quan');
        $('tong-quan').innerHTML =
          o('Khách hàng', k.khach) + o('Tiền đang nằm trong ví', V.tien(k.tienTrongVi)) +
          o('Tổng đã nạp', V.tien(k.tongNap)) + o('Yêu cầu rút chờ', k.rutCho) +
          o('Đơn chờ cấp key', k.donChoTay);
        function o(n, v) { return '<div><span>' + n + '</span><b>' + v + '</b></div>'; }
      }

      async function taiRut() {
        var k = await qt('/admin/rut');
        $('rut-trong').hidden = k.yeuCau.length > 0;
        $('rut-than').innerHTML = k.yeuCau.map(function (y) {
          return '<tr><td>' + V.ngay(y.luc) + '</td><td>' + y.email + '</td><td class="phai"><b>' +
            V.tien(y.thuc_nhan) + '</b></td><td>' + y.ngan_hang + '<br>' + y.so_tk + '<br>' + y.chu_tk +
            '</td><td><button class="nut nut-chinh" data-tra="' + y.id + '">Đã trả</button> ' +
            '<button class="nut nut-vien" data-mo-tuchoi="' + y.id + '">Từ chối</button></td></tr>' +
            '<tr data-o-tuchoi="' + y.id + '" hidden><td colspan="5">' +
            '<input class="o-nho o-rong" data-lydo="' + y.id + '" placeholder="Lý do từ chối (khách đọc được)" /> ' +
            '<button class="nut nut-chinh" data-tuchoi="' + y.id + '">Xác nhận từ chối và hoàn tiền</button> ' +
            '<button class="nut nut-vien" data-dong-tuchoi="' + y.id + '">Thôi</button></td></tr>';
        }).join('');
      }

      async function taiDon() {
        var k = await qt('/admin/don');
        $('don-trong').hidden = k.don.length > 0;
        $('don-than').innerHTML = k.don.map(function (d) {
          return '<tr><td>' + V.ngay(d.luc) + '</td><td>' + d.email + '</td><td>' + d.ten_pm +
            '</td><td>' + d.so_ngay + ' ngày</td><td>' + (d.ma_may || '—') + '</td><td class="phai">' +
            V.tien(d.gia) + '</td><td><input class="o-nho" data-key="' + d.id +
            '" placeholder="Dán key rồi Enter" /></td></tr>';
        }).join('');
      }

      async function taiKhach() {
        var k = await qt('/admin/nguoi?q=' + encodeURIComponent($('kh-tim').value.trim()));
        $('kh-than').innerHTML = k.nguoi.map(function (n) {
          return '<tr><td>' + n.email + (n.khoa ? ' 🔒' : '') + '</td><td>' + (n.ten || '') +
            '</td><td>' + n.ma_nap + '</td><td class="phai"><b>' + V.tien(n.so_du) +
            '</b></td><td class="phai">' + V.tien(n.da_nap) +
            '</td><td><button class="nut nut-vien" data-mo-tien="' + n.id + '">Cộng/trừ</button> ' +
            '<button class="nut nut-vien" data-khoa="' + n.id + '" data-dang="' + (n.khoa ? 1 : 0) + '">' +
            (n.khoa ? 'Mở khoá' : 'Khoá') + '</button></td></tr>' +
            '<tr data-o-tien="' + n.id + '" hidden><td colspan="6">' +
            '<input class="o-nho" type="number" step="1000" data-tien="' + n.id + '" placeholder="Số tiền, âm là trừ" /> ' +
            '<input class="o-nho o-rong" data-ghichu="' + n.id + '" placeholder="Ghi chú (khách đọc được)" /> ' +
            '<button class="nut nut-chinh" data-luu-tien="' + n.id + '">Lưu</button> ' +
            '<button class="nut nut-vien" data-dong-tien="' + n.id + '">Thôi</button></td></tr>';
        }).join('');
      }
      $('kh-nut').addEventListener('click', function () { taiKhach().catch(bao); });
      $('kh-tim').addEventListener('keydown', function (e) { if (e.key === 'Enter') taiKhach().catch(bao); });

      function moDong(ten, id, hien) {
        var tr = document.querySelector('[data-o-' + ten + '="' + id + '"]');
        if (tr) tr.hidden = !hien;
      }
      var oCua = function (ten, id) {
        return (document.querySelector('[data-' + ten + '="' + id + '"]') || {}).value || '';
      };

      document.addEventListener('click', async function (e) {
        var b = e.target.closest('button');
        if (!b) return;
        var d = b.dataset;
        try {
          if (d.moTuchoi) { moDong('tuchoi', d.moTuchoi, true); return; }
          if (d.dongTuchoi) { moDong('tuchoi', d.dongTuchoi, false); return; }
          if (d.moTien) { moDong('tien', d.moTien, true); return; }
          if (d.dongTien) { moDong('tien', d.dongTien, false); return; }

          if (d.tra) {
            // Bam hai lan thay cho hop thoai xac nhan
            if (d.sanSang !== '1') {
              d.sanSang = '1';
              b.textContent = 'Đã chuyển khoản rồi? Bấm lần nữa';
              setTimeout(function () { d.sanSang = '0'; b.textContent = 'Đã trả'; }, 6000);
              return;
            }
            bao('');
            await qt('/admin/rut', { id: d.tra, viec: 'tra' });
            taiHet();
          } else if (d.tuchoi) {
            bao('');
            await qt('/admin/rut', { id: d.tuchoi, viec: 'tuChoi', ghiChu: oCua('lydo', d.tuchoi) });
            taiHet();
          } else if (d.luuTien) {
            bao('');
            var so = Number(oCua('tien', d.luuTien));
            if (!so) return bao(new Error('Nhập số tiền đã — số âm là trừ.'));
            await qt('/admin/tien', {
              nguoi: Number(d.luuTien), soTien: so,
              ghiChu: oCua('ghichu', d.luuTien) || 'Chủ shop điều chỉnh',
            });
            taiKhach().catch(bao); taiTongQuan().catch(bao);
          } else if (d.khoa) {
            bao('');
            await qt('/admin/khoa', { nguoi: Number(d.khoa), khoa: d.dang !== '1' });
            taiKhach().catch(bao);
          }
        } catch (err) { bao(err); }
      });

      document.addEventListener('keydown', async function (e) {
        var i = e.target.closest('input[data-key]');
        if (!i || e.key !== 'Enter') return;
        try {
          bao('');
          await qt('/admin/don', { id: i.dataset.key, key: i.value.trim() });
          taiDon().catch(bao); taiTongQuan().catch(bao);
        } catch (err) { bao(err); }
      });

      var luu = localStorage.getItem('vi-qt');
      if (luu) { $('qt-ma').value = luu; vao(); }
    })();
  </script>
</Layout>
