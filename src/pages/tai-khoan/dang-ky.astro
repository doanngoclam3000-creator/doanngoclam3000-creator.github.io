---
import Layout from '../../layouts/Layout.astro';
import '../../styles/tai-khoan.css';
import NutGoogle from '../../components/NutGoogle.astro';
---
<Layout tieuDe="Đăng ký tài khoản" moTa="Tạo tài khoản để nạp tiền vào ví và mua key phần mềm ngay trên website.">
  <div class="tk-trang">
    <div class="tk-hep">
      <div class="tk-tieu">
        <h1>Tạo tài khoản</h1>
        <p>Nạp tiền vào ví rồi mua key phần mềm ngay, không phải chờ đối chiếu chuyển khoản.</p>
      </div>

      <div class="hop">
        <div class="loi" id="loi" hidden></div>
        <p class="loi-mo">Tất cả các ô đều bắt buộc, trừ ô mã giới thiệu.</p>
        <form id="form">
          <label class="o">
            <span>Tên tài khoản</span>
            <input type="text" id="tenDn" required minlength="3" maxlength="30" autocomplete="username" placeholder="vidu: lam2026" />
            <small id="nhac-ten">Dùng để đăng nhập. Chữ không dấu, số và dấu . _ - ; từ 3 đến 30 ký tự.</small>
          </label>
          <label class="o">
            <span>Mật khẩu</span>
            <input type="password" id="matKhau" required minlength="8" autocomplete="new-password" />
            <small>Ít nhất 8 ký tự.</small>
          </label>
          <label class="o">
            <span>Nhập lại mật khẩu</span>
            <input type="password" id="matKhau2" required minlength="8" autocomplete="new-password" />
            <small id="khop-mk">Gõ lại đúng mật khẩu ở trên cho chắc.</small>
          </label>
          <label class="o">
            <span>Email</span>
            <input type="email" id="email" required autocomplete="email" placeholder="ban@gmail.com" />
          </label>
          <label class="o">
            <span>Số điện thoại</span>
            <input type="tel" id="dienThoai" required autocomplete="tel" placeholder="09xx xxx xxx" />
            <small id="nhac-dt">Số di động 10 chữ số. Dùng để chủ shop liên hệ khi có việc về key.</small>
          </label>
          <label class="o">
            <span>Mã giới thiệu (nếu có)</span>
            <input type="text" id="gioiThieu" placeholder="Bỏ trống nếu không có" />
          </label>
          <button class="nut nut-chinh nut-day" id="nut" type="submit">Đăng ký</button>
        </form>
        <NutGoogle />
      </div>

      <p class="duoi-form">Đã có tài khoản? <a href="/tai-khoan/dang-nhap/">Đăng nhập</a></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('form');
      var nut = document.getElementById('nut');
      var gt = new URLSearchParams(location.search).get('gt');
      if (gt) document.getElementById('gioiThieu').value = gt;

      var oTen = document.getElementById('tenDn');
      var nhacTen = document.getElementById('nhac-ten');
      var mk1 = document.getElementById('matKhau');
      var mk2 = document.getElementById('matKhau2');
      var nhacMk = document.getElementById('khop-mk');

      var oDt = document.getElementById('dienThoai');
      var nhacDt = document.getElementById('nhac-dt');

      var TEN_CHUAN = 'Dùng để đăng nhập. Chữ không dấu, số và dấu . _ - ; từ 3 đến 30 ký tự.';
      var MK_CHUAN = 'Gõ lại đúng mật khẩu ở trên cho chắc.';
      var DT_CHUAN = 'Số di động 10 chữ số. Dùng để chủ shop liên hệ khi có việc về key.';
      var tenHopLe = function (t) { return /^[A-Za-z0-9._-]{3,30}$/.test(t); };
      // Nhan moi kieu khach hay go: "0912 345 678", "+84912345678" -> "0912345678"
      var chuanDt = function (t) {
        var x = String(t || '').replace(/[^0-9+]/g, '');
        if (x.indexOf('+84') === 0) x = '0' + x.slice(3);
        else if (x.indexOf('84') === 0 && x.length >= 11) x = '0' + x.slice(2);
        return x.replace(/\+/g, '');
      };
      var dtHopLe = function (t) {
        var x = chuanDt(t);
        return /^0[35789][0-9]{8}$/.test(x) || /^02[0-9]{8,9}$/.test(x);
      };

      // Bao ngay luc go, khong doi bam nut moi biet sai
      function nhac(o, chu, sai) {
        o.textContent = chu;
        o.style.color = sai ? '#dc2626' : '';
      }
      function soatTen() {
        if (oTen.value && !tenHopLe(oTen.value)) {
          nhac(nhacTen, 'Tên tài khoản không được có dấu tiếng Việt hay dấu cách. Từ 3 đến 30 ký tự.', true);
        } else nhac(nhacTen, TEN_CHUAN, false);
      }
      function soatKhop() {
        if (mk2.value && mk1.value !== mk2.value) nhac(nhacMk, 'Hai ô mật khẩu chưa giống nhau.', true);
        else nhac(nhacMk, MK_CHUAN, false);
      }
      function soatDt() {
        if (oDt.value && !dtHopLe(oDt.value)) {
          nhac(nhacDt, 'Số điện thoại chưa đúng. Điền số di động 10 chữ số, ví dụ 0912345678.', true);
        } else nhac(nhacDt, DT_CHUAN, false);
      }
      oTen.addEventListener('input', soatTen);
      mk1.addEventListener('input', soatKhop);
      mk2.addEventListener('input', soatKhop);
      oDt.addEventListener('input', soatDt);

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        window.VI.baoLoi('loi', '');
        if (!tenHopLe(oTen.value.trim())) {
          oTen.focus();
          return window.VI.baoLoi('loi', new Error('Tên tài khoản chỉ gồm chữ không dấu, số và dấu . _ - ; từ 3 đến 30 ký tự.'));
        }
        if (mk1.value !== mk2.value) {
          mk2.focus();
          return window.VI.baoLoi('loi', new Error('Hai ô mật khẩu chưa giống nhau. Gõ lại giúp tôi.'));
        }
        if (!dtHopLe(oDt.value)) {
          oDt.focus();
          return window.VI.baoLoi('loi', new Error('Điền số điện thoại di động 10 chữ số, ví dụ 0912345678.'));
        }
        nut.disabled = true; nut.textContent = 'Đang tạo…';
        try {
          var kq = await window.VI.goi('/dk', {
            tenDn: oTen.value.trim(),
            matKhau: mk1.value,
            email: document.getElementById('email').value.trim(),
            dienThoai: chuanDt(oDt.value),
            gioiThieu: document.getElementById('gioiThieu').value.trim(),
          });
          window.VI.datToken(kq.token);
          location.href = '/tai-khoan/';
        } catch (err) {
          window.VI.baoLoi('loi', err);
          nut.disabled = false; nut.textContent = 'Đăng ký';
        }
      });
    })();
  </script>
</Layout>
