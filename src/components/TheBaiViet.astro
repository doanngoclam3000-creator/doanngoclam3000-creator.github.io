---
import { CHUYEN_MUC, dinhDangNgay } from '../config';
const { bai, ngang = false } = Astro.props;
const cm = CHUYEN_MUC[bai.data.chuyenMuc];
---
<article class:list={['the', ngang && 'ngang']}>
  <a href={`/bai-viet/${bai.id}`} class="anh" style={`--mau:${cm.mau}`}>
    {bai.data.anh ? <img src={bai.data.anh} alt={bai.data.tieuDe} loading="lazy" /> : <span class="bieu-tuong">{cm.icon}</span>}
  </a>
  <div class="than">
    <a href={`/chuyen-muc/${bai.data.chuyenMuc}`} class="nhan" style={`background:${cm.mau}1a;color:${cm.mau}`}>{cm.ten}</a>
    <h3><a href={`/bai-viet/${bai.id}`}>{bai.data.tieuDe}</a></h3>
    <p class="chu-nhat nho tom-tat">{bai.data.moTa}</p>
    <div class="chan-the chu-nhat nho">
      <time datetime={bai.data.ngayDang.toISOString()}>{dinhDangNgay(bai.data.ngayDang)}</time>
      {bai.data.thuocPhanMem && <><span>·</span><a href={`/phan-mem/${bai.data.thuocPhanMem}`}>{bai.data.thuocPhanMem}</a></>}
    </div>
  </div>
</article>

<style>
  .anh {
    display: grid; place-items: center; aspect-ratio: 16/9; overflow: hidden;
    background: linear-gradient(135deg, color-mix(in srgb, var(--mau) 18%, var(--nen-the)), var(--nen-phu));
    border-bottom: 1px solid var(--vien);
  }
  .anh img { width: 100%; height: 100%; object-fit: cover; }
  .bieu-tuong { font-size: 2.6rem; opacity: .9; }
  .than { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
  .than h3 { font-size: 1.08rem; margin: .6rem 0 .4rem; }
  .than h3 a { color: var(--chu); }
  .the:hover h3 a { color: var(--chinh); }
  .tom-tat { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: .8rem; }
  .chan-the { display: flex; gap: .45rem; align-items: center; margin-top: auto; flex-wrap: wrap; }
  .ngang { flex-direction: row; }
  .ngang .anh { aspect-ratio: 1; width: 150px; flex-shrink: 0; border-bottom: none; border-right: 1px solid var(--vien); }
  @media (max-width: 560px) { .ngang { flex-direction: column; } .ngang .anh { width: 100%; aspect-ratio: 16/9; border-right: none; border-bottom: 1px solid var(--vien); } }
</style>
