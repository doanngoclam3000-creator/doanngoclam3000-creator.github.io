---
// Popup bao co phien ban moi, hien MOT LAN cho moi khach.
// Lay phan mem duoc cap nhat gan day nhat. Khi ra ban moi (doi phienBan hoac
// ngayCapNhat) thi popup tu hien lai mot lan nua.
import { getCollection } from 'astro:content';
import { CAUHINH, dinhDangNgay } from '../config';

const dsPhanMem = await getCollection('phan-mem');
const moiNhat = dsPhanMem
  .slice()
  .sort((a, b) => +b.data.ngayCapNhat - +a.data.ngayCapNhat)[0];

// Ma nhan dang ban phat hanh: doi ma nay thi popup hien lai
const maBan = moiNhat
  ? `${moiNhat.id}-${moiNhat.data.phienBan ?? ''}-${moiNhat.data.ngayCapNhat.toISOString().slice(0, 10)}`
  : '';

// Ghi chu cap nhat viet nhieu dong "- ...", cat lay vai y dau cho gon
const y = (moiNhat?.data.ghiChuCapNhat ?? '')
  .split('\n')
  .map((d) => d.replace(/^\s*[-*]\s*/, '').replace(/\*\*/g, '').trim())
  .filter(Boolean);
const yNoiBat = y.slice(0, 3);
const conNua = y.length - yNoiBat.length;

const hien = CAUHINH.thongBaoBanMoi && !!moiNhat;
---
{hien && (
<div
  class="lop-phu"
  id="bao-ban-moi"
  data-ma-ban={maBan}
  data-duong-dan={`/phan-mem/${moiNhat.id}`}
  hidden
>
  <div class="hop" role="dialog" aria-modal="true" aria-labelledby="bao-ban-moi-tieu-de" style={`--mau:${moiNhat.data.mauNen}`}>
    <button class="dong" type="button" aria-label="Đóng thông báo">×</button>

    <div class="dinh">
      <span class="nhan">Phiên bản mới</span>
      {moiNhat.data.anhIcon
        ? <img class="icon" src={moiNhat.data.anhIcon} alt={moiNhat.data.ten} width="64" height="64" />
        : <span class="icon icon-emoji">{moiNhat.data.icon}</span>}
    </div>

    <div class="than">
      <h3 id="bao-ban-moi-tieu-de">
        {moiNhat.data.ten}
        {moiNhat.data.phienBan && <span class="ver">{moiNhat.data.phienBan}</span>}
      </h3>
      {yNoiBat.length > 0 ? (
        <ul class="y-moi">
          {yNoiBat.map((d) => <li>{d}</li>)}
          {conNua > 0 && <li class="con-nua">và {conNua} thay đổi khác…</li>}
        </ul>
      ) : (
        <p class="mo-ta">{moiNhat.data.moTa}</p>
      )}
      <p class="ngay">Cập nhật {dinhDangNgay(moiNhat.data.ngayCapNhat)}</p>

      <div class="hd">
        <a class="nut-tai" href={`/phan-mem/${moiNhat.id}#tai-ve`}>⬇︎ Tải bản mới</a>
        <button class="nut-sau" type="button">Để sau</button>
      </div>
    </div>
  </div>
</div>
)}

<script is:inline>
  (function () {
    var lop = document.getElementById('bao-ban-moi');
    if (!lop) return;

    var KHOA = 'da-xem-ban-moi';
    var maBan = lop.dataset.maBan;

    // Da xem dung ban nay roi thi thoi
    try {
      if (localStorage.getItem(KHOA) === maBan) return;
    } catch (e) {}

    // Dang o ngay trang phan mem do thi khong can bao nua
    if (location.pathname.indexOf(lop.dataset.duongDan) === 0) return;

    function ghiNho() {
      try { localStorage.setItem(KHOA, maBan); } catch (e) {}
    }

    function dong() {
      ghiNho();
      lop.classList.remove('mo');
      document.body.style.overflow = '';
      setTimeout(function () { lop.hidden = true; }, 220);
      document.removeEventListener('keydown', phimEsc);
    }

    function phimEsc(e) {
      if (e.key === 'Escape') dong();
    }

    lop.querySelector('.dong').addEventListener('click', dong);
    lop.querySelector('.nut-sau').addEventListener('click', dong);
    lop.querySelector('.nut-tai').addEventListener('click', ghiNho);
    lop.addEventListener('click', function (e) {
      if (e.target === lop) dong();
    });

    // Cho trang hien ra on dinh roi moi bat popup
    setTimeout(function () {
      lop.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () { lop.classList.add('mo'); });
      document.addEventListener('keydown', phimEsc);
    }, 700);
  })();
</script>

<style>
  .lop-phu {
    position: fixed; inset: 0; z-index: 90;
    display: grid; place-items: center; padding: 20px;
    background: rgba(15, 23, 42, .55);
    backdrop-filter: blur(3px);
    opacity: 0; transition: opacity .22s ease;
  }
  .lop-phu.mo { opacity: 1; }
  .lop-phu[hidden] { display: none; }

  .hop {
    position: relative; width: min(420px, 100%);
    background: var(--nen-the); border: 1px solid var(--vien);
    border-radius: 20px; overflow: hidden;
    box-shadow: 0 26px 70px rgba(0, 0, 0, .38);
    transform: translateY(14px) scale(.97);
    transition: transform .24s cubic-bezier(.2, .8, .3, 1);
  }
  .lop-phu.mo .hop { transform: none; }

  .dong {
    position: absolute; top: 10px; right: 12px; z-index: 2;
    width: 32px; height: 32px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .22); color: #fff;
    font-size: 1.3rem; line-height: 1; cursor: pointer; transition: .16s ease;
  }
  .dong:hover { background: rgba(255, 255, 255, .38); }

  .dinh {
    display: flex; align-items: center; gap: 14px; padding: 20px 22px;
    background: linear-gradient(135deg, var(--mau), color-mix(in srgb, var(--mau) 55%, #000));
  }
  .nhan {
    background: rgba(255, 255, 255, .22); color: #fff;
    font-size: .74rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: .3rem .7rem; border-radius: 999px;
  }
  .icon { width: 64px; height: 64px; border-radius: 16px; margin-left: auto; box-shadow: 0 8px 22px rgba(0, 0, 0, .35); }
  .icon-emoji {
    display: grid; place-items: center; font-size: 2.1rem;
    background: rgba(255, 255, 255, .18);
  }

  .than { padding: 20px 22px 22px; }
  .than h3 { margin: 0 0 .5rem; font-size: 1.2rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .ver {
    font-size: .8rem; font-weight: 700; color: var(--mau);
    background: color-mix(in srgb, var(--mau) 14%, transparent);
    padding: .16rem .5rem; border-radius: 999px;
  }
  .mo-ta { margin: 0; color: var(--chu-nhat); font-size: .95rem; line-height: 1.6; }
  .y-moi { margin: 0; padding-left: 1.1rem; color: var(--chu-nhat); font-size: .92rem; line-height: 1.55; }
  .y-moi li { margin-bottom: .3rem; }
  .y-moi li::marker { color: var(--mau); }
  .con-nua { opacity: .75; font-style: italic; }
  .ngay { margin: .5rem 0 0; font-size: .82rem; color: var(--chu-nhat); opacity: .8; }

  .hd { display: flex; gap: .6rem; margin-top: 1.1rem; }
  .nut-tai {
    flex: 1; display: inline-flex; align-items: center; justify-content: center;
    padding: .7rem 1rem; border-radius: 12px; font-weight: 600; color: #fff;
    background: linear-gradient(135deg, var(--mau), color-mix(in srgb, var(--mau) 62%, #000));
    box-shadow: 0 6px 18px color-mix(in srgb, var(--mau) 32%, transparent);
    transition: .18s ease;
  }
  .nut-tai:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 10px 26px color-mix(in srgb, var(--mau) 44%, transparent); }
  .nut-sau {
    padding: .7rem 1rem; border-radius: 12px; cursor: pointer;
    background: transparent; border: 1px solid var(--vien); color: var(--chu-nhat);
    font-size: .92rem; font-family: inherit; transition: .16s ease;
  }
  .nut-sau:hover { background: var(--nen-phu); color: var(--chu); }

  @media (max-width: 480px) {
    .lop-phu { place-items: end center; padding: 0; }
    .hop { width: 100%; border-radius: 20px 20px 0 0; border-bottom: 0; }
    .dinh { padding: 18px; }
    .than { padding: 18px 18px 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lop-phu, .hop { transition: none; }
  }
</style>
