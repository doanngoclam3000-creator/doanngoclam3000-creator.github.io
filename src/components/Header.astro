---
import { CAUHINH, CHUYEN_MUC } from '../config';
const p = Astro.url.pathname;
const dangO = (h: string) => (h === '/' ? p === '/' : p.startsWith(h));
---
<header class="dau-trang">
  <div class="khung thanh">
    <a href="/" class="logo">
      <span class="logo-o">PM</span>
      <span class="logo-chu">{CAUHINH.tenSite}</span>
    </a>

    <nav class="menu" id="menu">
      <a href="/" class:list={['muc', dangO('/') && 'dang-o']}>Trang chủ</a>
      <a href="/phan-mem" class:list={['muc', dangO('/phan-mem') && 'dang-o']}>Phần mềm</a>
      <div class="tha-xuong">
        <a href="/bai-viet" class:list={['muc', dangO('/bai-viet') && 'dang-o']}>Bài viết ▾</a>
        <div class="bang">
          {Object.entries(CHUYEN_MUC).map(([ma, cm]) => (
            <a href={`/chuyen-muc/${ma}`}>
              <span class="cm-icon">{cm.icon}</span>
              <span><b>{cm.ten}</b><small>{cm.moTa}</small></span>
            </a>
          ))}
        </div>
      </div>
      <a href="/gioi-thieu" class:list={['muc', dangO('/gioi-thieu') && 'dang-o']}>Giới thiệu</a>
      <a href="/lien-he" class:list={['muc', dangO('/lien-he') && 'dang-o']}>Liên hệ</a>
      <a href="/tai-khoan/dang-nhap" class:list={['muc', 'chi-khach']} id="menu-dang-nhap">Đăng nhập</a>
      <a href="/tai-khoan" class:list={['muc', dangO('/tai-khoan') && 'dang-o']} id="menu-vi" hidden>Ví của tôi <b class="so-du" id="so-du-menu">0đ</b></a>
    </nav>

    <div class="phai">
      <button id="doi-giao-dien" class="nut-tron" aria-label="Đổi giao diện sáng/tối" title="Sáng / Tối">
        <span class="hien-sang">🌙</span><span class="hien-toi">☀️</span>
      </button>
      <a href="/tai-khoan/dang-nhap/" class="nut nut-vien nut-dn" id="nut-dang-nhap">Đăng nhập</a>
      <a href="/tai-khoan/" class="nut nut-vien nut-dn" id="nut-vi" hidden>Ví của tôi <b class="so-du" id="so-du-nut">0đ</b></a>
      <a href="/phan-mem" class="nut nut-chinh nut-tai">Tải phần mềm</a>
      <button id="mo-menu" class="nut-tron chi-mobile" aria-label="Mở menu">☰</button>
    </div>
  </div>
</header>

<style>
  .dau-trang {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--nen) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--vien);
  }
  .thanh { display: flex; align-items: center; gap: 1rem; height: 64px; }
  .logo { display: flex; align-items: center; gap: .6rem; font-weight: 800; color: var(--chu); font-size: 1.05rem; }
  .logo-o {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
    background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; font-size: .8rem; letter-spacing: .02em;
  }
  .menu { display: flex; align-items: center; gap: .25rem; margin-left: 1rem; }
  .muc {
    padding: .5rem .8rem; border-radius: 9px; color: var(--chu-nhat); font-weight: 500; font-size: .95rem;
    /* Khong co dong nay thi man hinh hep mot chut la "Phan mem", "Bai viet",
       "Gioi thieu"... deu bi be doi thanh hai dong, menu cao gap doi va rat xau. */
    white-space: nowrap;
  }
  /* So du hien ngay canh chu "Vi cua toi" */
  .so-du {
    margin-left: .35rem; padding: .1rem .4rem; border-radius: 6px;
    background: var(--chinh-nhat); color: var(--chinh);
    font-size: .82em; font-weight: 700; white-space: nowrap;
  }
  /* "Dang nhap" / "Vi cua toi" NAM TRONG MENU chi danh cho man hinh hep.
     O man rong da co hai nut ben phai lam dung viec do - de ca hai vua trung
     lap vua chiem cho, day menu vo thanh hai dong. */
  .menu #menu-dang-nhap, .menu #menu-vi { display: none; }
  .muc:hover { background: var(--nen-phu); color: var(--chu); }
  .dang-o { color: var(--chinh); background: var(--chinh-nhat); }
  .tha-xuong { position: relative; }
  .bang {
    position: absolute; top: calc(100% + 8px); left: 0; width: 320px; padding: 8px;
    background: var(--nen-the); border: 1px solid var(--vien); border-radius: 14px; box-shadow: var(--bong-cao);
    opacity: 0; visibility: hidden; transform: translateY(-6px); transition: .16s ease;
  }
  .tha-xuong:hover .bang, .tha-xuong:focus-within .bang { opacity: 1; visibility: visible; transform: none; }
  .bang a { display: flex; gap: .7rem; padding: .6rem .7rem; border-radius: 10px; color: var(--chu); }
  .bang a:hover { background: var(--nen-phu); }
  .bang b { display: block; font-size: .95rem; }
  .bang small { color: var(--chu-nhat); font-size: .8rem; line-height: 1.4; display: block; }
  .cm-icon { font-size: 1.1rem; }
  .phai { margin-left: auto; display: flex; align-items: center; gap: .6rem; }
  .nut-tron {
    width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px;
    background: transparent; border: 1px solid var(--vien); cursor: pointer; font-size: 1rem; color: var(--chu);
  }
  .nut-tron:hover { background: var(--nen-phu); }
  html[data-theme='dark'] .hien-sang, html:not([data-theme='dark']) .hien-toi { display: none; }
  .chi-mobile { display: none; }
  .nut-dn { white-space: nowrap; }

  /* Khoang giua: van du cho mot hang, chi can bop thua lai */
  @media (max-width: 1150px) {
    .menu { gap: 0; margin-left: .4rem; }
    .muc { padding: .5rem .55rem; font-size: .9rem; }
    .phai { gap: .4rem; }
  }

  @media (max-width: 900px) {
    .nut-tai, .nut-dn { display: none; }
    .menu #menu-dang-nhap:not([hidden]), .menu #menu-vi:not([hidden]) { display: block; }
    .chi-mobile { display: grid; }
    .menu {
      position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; align-items: stretch;
      background: var(--nen); border-bottom: 1px solid var(--vien); padding: 10px 16px 18px; gap: .2rem;
      margin: 0; display: none;
    }
    .menu.mo { display: flex; }
    .bang { position: static; width: auto; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: none; padding: 0 0 0 .6rem; }
  }
</style>

<script>
  const nutGD = document.getElementById('doi-giao-dien');
  nutGD?.addEventListener('click', () => {
    const moi = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = moi;
    localStorage.setItem('giao-dien', moi);
  });
  document.getElementById('mo-menu')?.addEventListener('click', () => {
    document.getElementById('menu')?.classList.toggle('mo');
  });
</script>

<script is:inline>
  // Da dang nhap thi doi "Dang nhap" thanh "Vi cua toi".
  // Chay ngay tai day cho khoi nhay chu luc trang vua hien ra.
  (function () {
    if (!localStorage.getItem('vi-token')) return;
    ['nut-dang-nhap', 'menu-dang-nhap'].forEach(function (id) {
      var e = document.getElementById(id);
      if (e) e.hidden = true;
    });
    ['nut-vi', 'menu-vi'].forEach(function (id) {
      var e = document.getElementById(id);
      if (e) e.hidden = false;
    });

    // Hien SO DU ngay tren thanh menu, thay cho viec phai vao trang vi moi biet.
    // De san "0d" trong HTML roi thay so that khi may chu tra ve: khong thi
    // luc trang vua hien, cho so du con trong lam menu giat mot cai.
    if (window.VI) {
      window.VI.goi('/toi').then(function (k) {
        var so = window.VI.tien((k.nguoi && k.nguoi.soDu) || 0);
        ['so-du-menu', 'so-du-nut'].forEach(function (id) {
          var e = document.getElementById(id);
          if (e) e.textContent = so;
        });
      }).catch(function () { /* mat mang hoac het phien - cu de 0d */ });
    }
  })();
</script>
