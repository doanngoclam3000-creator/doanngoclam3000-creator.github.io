---
const { src } = Astro.props;
// Nhan dang link YouTube de nhung, con lai coi la file video trong thu muc public/
function idYouTube(u: string): string | null {
  const m = u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/|v\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/);
  return m ? m[1] : null;
}
const yt = idYouTube(src);
---
<div class="khung-video">
  {yt
    ? <iframe
        src={`https://www.youtube-nocookie.com/embed/${yt}`}
        title="Video hướng dẫn"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture"
        allowfullscreen
      />
    : <video src={src} controls preload="metadata" playsinline />}
</div>

<style>
  .khung-video {
    position: relative; width: 100%; aspect-ratio: 16/9; margin: 1.8rem 0;
    border-radius: 14px; overflow: hidden; border: 1px solid var(--vien); background: #000;
  }
  .khung-video iframe, .khung-video video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
